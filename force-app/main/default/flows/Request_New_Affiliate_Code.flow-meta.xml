    <formulas>
        <name>GeneratedCodeFormula</name>
        <dataType>String</dataType>
        <expression>UPPER(LEFT({!Get_Running_Account.Name}, 4)) &amp; TEXT(HOUR(TIMEVALUE(NOW()))*3600 + MINUTE(TIMEVALUE(NOW()))*60 + SECOND(TIMEVALUE(NOW())))</expression>
    </formulas>
    <formulas>
        <name>ValidToFormula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
