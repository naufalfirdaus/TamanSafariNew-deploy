<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Gap__c</fullName>
    <description>Opportunity Amount minus total scheduled payments. Must be 0 for the data to reconcile.</description>
    <formula>BLANKVALUE(Amount, 0) - Total_Payment_Scheduled__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Payment Gap</label>
    <precision>18</precision>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
