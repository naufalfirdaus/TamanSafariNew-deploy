<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Wajib_Loss_Reason_Sebelum_Closed_Lost</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  ISPICKVAL(StageName, &quot;Closed Lost&quot;),
  ISPICKVAL(Loss_Reason__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Loss_Reason__c</errorDisplayField>
    <errorMessage>Pilih alasan kekalahan sebelum menutup Opportunity sebagai Closed Lost.</errorMessage>
</ValidationRule>
