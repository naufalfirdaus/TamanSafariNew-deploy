<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <choices>
        <name>Choice_Accommodation</name>
        <choiceText>Accommodation</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Accommodation</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Bundled_Package</name>
        <choiceText>Bundled Package</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Bundled Package</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_FnB</name>
        <choiceText>F&amp;B</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>F&amp;B</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Team_Building</name>
        <choiceText>Team Building</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Team Building</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Ticket_Voucher</name>
        <choiceText>Ticket &amp; Voucher</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Ticket &amp; Voucher</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Transport</name>
        <choiceText>Transport</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Transport</stringValue>
        </value>
