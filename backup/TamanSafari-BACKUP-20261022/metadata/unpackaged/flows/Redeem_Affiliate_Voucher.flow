    <decisions>
        <name>Kode_Valid</name>
        <label>Kode Valid?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Screen_Gagal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tidak Valid</defaultConnectorLabel>
        <rules>
            <name>Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Affiliate_Code.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Input_Transaksi</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CommissionAmountFormula</name>
        <dataType>Currency</dataType>
        <expression>{!grossAmountInput} * 0.10</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>OppNameFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Redeem - &quot; &amp; {!voucherCodeInput} &amp; &quot; - &quot; &amp; TEXT({!$Flow.CurrentDate})</expression>
    </formulas>
    <formulas>
        <name>UnitPriceFormula</name>
        <dataType>Currency</dataType>
        <expression>{!grossAmountInput} / {!qtyInput}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Redeem Affiliate Voucher {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Redeem Affiliate Voucher</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Opportunity</name>
        <label>Create Opportunity</label>
        <locationX>176</locationX>
        <locationY>508</locationY>
        <connector>
            <targetReference>Create_Opportunity_Line_Item</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <stringValue>001bm00002XmPhdAAF</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount</field>
            <value>
                <elementReference>grossAmountInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LeadSource</field>
            <value>
                <stringValue>Partner</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>OppNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SDO_Sales_Partner_Owner__c</field>
            <value>
                <elementReference>Get_Affiliate_Code.Afiliator__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Qualification</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Opportunity_Line_Item</name>
        <label>Create Opportunity Line Item</label>
        <locationX>176</locationX>
        <locationY>616</locationY>
        <connector>
            <targetReference>Advance_Opportunity_Closed_Won</targetReference>
        </connector>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>Create_Opportunity.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PricebookEntryId</field>
            <value>
                <stringValue>01ubm000007Vb7QAAS</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity</field>
            <value>
                <elementReference>qtyInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <elementReference>UnitPriceFormula</elementReference>
            </value>
        </inputAssignments>
        <object>OpportunityLineItem</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Redemption</name>
        <label>Create Redemption</label>
        <locationX>176</locationX>
        <locationY>832</locationY>
        <connector>
            <targetReference>Screen_Berhasil</targetReference>
        </connector>
        <inputAssignments>
            <field>Affiliate_Code__c</field>
            <value>
                <elementReference>Get_Affiliate_Code.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Afiliator__c</field>
            <value>
                <elementReference>Get_Affiliate_Code.Afiliator__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Booking_Ref__c</field>
            <value>
                <elementReference>bookingNumberInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Commission_Amount__c</field>
            <value>
                <elementReference>CommissionAmountFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Commission_Rate__c</field>
            <value>
                <numberValue>10.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Gross_Amount__c</field>
            <value>
                <elementReference>grossAmountInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Family__c</field>
            <value>
                <elementReference>productFamilyInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Qty_Redeemed__c</field>
            <value>
                <elementReference>qtyInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Redemption_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Accrued</stringValue>
            </value>
        </inputAssignments>
        <object>Redemption__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Affiliate_Code</name>
        <label>Get Affiliate Code</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Kode_Valid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>voucherCodeInput</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Valid_To__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Affiliate_Code__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Advance_Opportunity_Closed_Won</name>
        <label>Advance Opportunity to Closed Won</label>
        <locationX>176</locationX>
        <locationY>724</locationY>
        <connector>
            <targetReference>Create_Redemption</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Create_Opportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Input_Kode</name>
        <label>Masukkan Kode Voucher</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Affiliate_Code</targetReference>
        </connector>
        <fields>
            <name>voucherCodeInput</name>
            <dataType>String</dataType>
            <fieldText>Masukkan Kode Voucher</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Input_Transaksi</name>
        <label>Detail Transaksi</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Opportunity</targetReference>
        </connector>
        <fields>
            <name>customerNameInput</name>
            <dataType>String</dataType>
            <fieldText>Nama Pembeli</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>bookingNumberInput</name>
            <dataType>String</dataType>
            <fieldText>Nomor Booking / Tiket</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>productFamilyInput</name>
            <choiceReferences>Choice_Ticket_Voucher</choiceReferences>
            <choiceReferences>Choice_Accommodation</choiceReferences>
            <choiceReferences>Choice_Team_Building</choiceReferences>
            <choiceReferences>Choice_Transport</choiceReferences>
            <choiceReferences>Choice_FnB</choiceReferences>
            <choiceReferences>Choice_Bundled_Package</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Produk / Kategori</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>qtyInput</name>
            <dataType>Number</dataType>
            <defaultValue>
                <numberValue>1.0</numberValue>
            </defaultValue>
            <fieldText>Jumlah / Qty</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>grossAmountInput</name>
            <dataType>Currency</dataType>
            <fieldText>Total Belanja (Rp)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Berhasil</name>
        <label>Redeem Berhasil</label>
        <locationX>50</locationX>
        <locationY>950</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>successMessage</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Voucher berhasil diredeem!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Selamat menikmati layanan Taman Safari Indonesia.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Gagal</name>
        <label>Redeem Gagal</label>
        <locationX>302</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>failureMessage</name>
            <fieldText>&lt;p&gt;Kode voucher tidak ditemukan, sudah kedaluwarsa, atau tidak aktif.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Input_Kode</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
