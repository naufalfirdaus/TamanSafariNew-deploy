    <fields>
        <fullName>SDO_Sales_Lead_Quality__c</fullName>
        <externalId>false</externalId>
        <formula>IMAGE(&apos;/servlet/servlet.FileDownload?file=&apos;&amp; IF (SDO_Sales_Lead_Total__c &gt; 0, &apos;015bm00000C9YQD&apos;, &apos;015bm00000C9YQE&apos;),&apos;&apos;,24,22) &amp;&quot;&quot;&amp;
IMAGE(&apos;/servlet/servlet.FileDownload?file=&apos;&amp; IF (SDO_Sales_Lead_Total__c &gt; 5, &apos;015bm00000C9YQD&apos;, &apos;015bm00000C9YQE&apos;),&apos;&apos;,24,22) &amp;&quot;&quot;&amp;
IMAGE(&apos;/servlet/servlet.FileDownload?file=&apos;&amp; IF (SDO_Sales_Lead_Total__c &gt; 10, &apos;015bm00000C9YQD&apos;, &apos;015bm00000C9YQE&apos;),&apos;&apos;,24,22) &amp;&quot;&quot;&amp;
IMAGE(&apos;/servlet/servlet.FileDownload?file=&apos;&amp; IF (SDO_Sales_Lead_Total__c &gt; 15, &apos;015bm00000C9YQD&apos;, &apos;015bm00000C9YQE&apos;),&apos;&apos;,24,22)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead Quality</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SDO_Sales_Lead_Total__c</fullName>
        <description>What: Formula to calculate total score from score fields.</description>
        <externalId>false</externalId>
        <formula>Score1__c + Score2__c  +Score3__c + Score4__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
