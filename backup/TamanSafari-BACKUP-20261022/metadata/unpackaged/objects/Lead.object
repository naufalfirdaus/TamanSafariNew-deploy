    <recordTypeTrackFeedHistory>false</recordTypeTrackFeedHistory>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <recordTypes>
        <fullName>Lead_Partner_Application</fullName>
        <active>true</active>
        <businessProcess>Partner Recruitment</businessProcess>
        <description>Used when a potential partner applies to the partner program.</description>
        <label>Lead - Partner Application</label>
        <picklistValues>
            <picklist>Disqualification_Reason__c</picklist>
            <values>
                <fullName>Budget</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Bukan Target Segment</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Duplikat</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>No Response</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Timing</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
