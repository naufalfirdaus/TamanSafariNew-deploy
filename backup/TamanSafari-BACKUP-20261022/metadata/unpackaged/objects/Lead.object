        <fullName>Priority__c</fullName>
        <externalId>false</externalId>
        <formula>IMAGE( URLsrc__c&amp;&quot;/servlet/servlet.ImageServer?id=&quot;&amp;CASE( Rating,
&quot;Hot&quot;, &quot;015bm00000C9YQK&amp;oid=&quot;&amp;$Organization.Id,
&quot;Warm&quot;, &quot;015bm00000C9YQL&amp;oid=&quot;&amp;$Organization.Id,
&quot;Cool&quot;, &quot;015bm00000C9YQM&amp;oid=&quot;&amp;$Organization.Id,
&quot;015bm00000C9YQM&amp;oid=&quot;&amp;$Organization.Id),&quot;&quot;,22,22)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Priority</label>
        <required>false</required>
