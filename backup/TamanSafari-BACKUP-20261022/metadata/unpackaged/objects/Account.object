        <fullName>SDO_Sales_Goal_Attainment__c</fullName>
        <description>What: Measure of YTD Revenue vs. Goal</description>
        <externalId>false</externalId>
        <formula>SDO_YTD_Revenue_Generated__c  /  SDO_Sales_Current_Year_Revenue_Goal__c</formula>
        <label>% Goal Attainment</label>
