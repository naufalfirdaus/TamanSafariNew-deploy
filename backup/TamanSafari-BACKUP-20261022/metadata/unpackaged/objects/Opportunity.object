    <fields>
        <fullName>Health_Status__c</fullName>
        <description>Status kesehatan Opportunity berdasarkan Days_Since_Last_Activity__c -- dasar untuk flagging stale opportunity di dashboard dan Flow Stale Opportunity Nudge.</description>
        <externalId>false</externalId>
        <formula>IF(Days_Since_Last_Activity__c &lt;= 14, &quot;Aktif&quot;, IF(Days_Since_Last_Activity__c &lt;= 30, &quot;Perlu Follow Up&quot;, &quot;Stagnan&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Health Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
