    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Payment_Required_Before_Closed_Won</fullName>
        <active>true</active>
        <description>Taman Safari deals with a payment plan must be fully paid before Closed Won. Opportunities without Payment Terms (e.g. voucher redemption) are not affected.</description>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  ISPICKVAL(StageName, &quot;Closed Won&quot;),
  Payment_Terms__c &gt; 0,
  Total_Paid__c &lt; BLANKVALUE(Amount, 0)
)</errorConditionFormula>
        <errorMessage>Opportunity must be fully paid before Closed Won. Mark all Payments as Paid so Total Paid equals Amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Payment_Terms_Locked_After_Proposal</fullName>
        <active>true</active>
        <description>Payment Terms are fixed once the proposal is processed: cannot be changed when the previous stage is Proposal/Quote, Negotiation, Closed Won or Closed Lost. Setting terms in the same save that moves the deal to Proposal/Quote is still allowed.</description>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  NOT(ISNEW()),
  ISCHANGED(Payment_Terms__c),
  OR(
    ISPICKVAL(PRIORVALUE(StageName), &quot;Proposal/Quote&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Negotiation&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Won&quot;),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Lost&quot;)
  )
)</errorConditionFormula>
        <errorDisplayField>Payment_Terms__c</errorDisplayField>
        <errorMessage>Payment Terms can no longer be changed because the proposal has already been processed (Proposal/Quote or later). Set the terms before moving to Proposal/Quote.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Payment_Terms_Rules</fullName>
        <active>true</active>
        <description>Payment Terms must be 1-12, and cannot be changed once a payment has been marked Paid.</description>
        <errorConditionFormula>OR(
  AND(NOT(ISBLANK(Payment_Terms__c)), OR(Payment_Terms__c &lt; 1, Payment_Terms__c &gt; 12)),
  AND(ISCHANGED(Payment_Terms__c), NOT(ISNEW()), Total_Paid__c &gt; 0)
)</errorConditionFormula>
        <errorDisplayField>Payment_Terms__c</errorDisplayField>
        <errorMessage>Payment Terms must be between 1 and 12 and cannot be changed after a payment has been marked Paid.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Wajib_Loss_Reason_Sebelum_Closed_Lost</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  ISPICKVAL(StageName, &quot;Closed Lost&quot;),
  ISPICKVAL(Loss_Reason__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Loss_Reason__c</errorDisplayField>
        <errorMessage>Pilih alasan kekalahan sebelum menutup Opportunity sebagai Closed Lost.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Wajib_PO_Sebelum_Closed_Won</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  ISPICKVAL(StageName, &quot;Closed Won&quot;),
  ISBLANK(PO_Number__c)
)</errorConditionFormula>
        <errorDisplayField>PO_Number__c</errorDisplayField>
        <errorMessage>Nomor PO wajib diisi sebelum Opportunity ditutup sebagai Closed Won.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Wajib_produk_sebelum_quotation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  RecordType.DeveloperName = &quot;Taman_Safari&quot;,
  OR(
    ISPICKVAL(StageName, &quot;Proposal/Quote&quot;),
    ISPICKVAL(StageName, &quot;Negotiation&quot;),
    ISPICKVAL(StageName, &quot;Closed Won&quot;)
  ),
  NOT(HasOpportunityLineItem)
)</errorConditionFormula>
        <errorDisplayField>StageName</errorDisplayField>
        <errorMessage>Tambahkan produk terlebih dahulu di tab Products sebelum melanjutkan ke tahap ini.</errorMessage>
    </validationRules>
</CustomObject>
