<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <!-- HANYA untuk Record Page -->
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="showErrors" type="Boolean" default="false"/>
            <property name="showMap" type="Boolean" default="true"/>
            <property name="zoomLevel" type="Integer" default="15"/>
            <property name="recordId" type="String"/>
            <property name="objectApiName" type="String"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>